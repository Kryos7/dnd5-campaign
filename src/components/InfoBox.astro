---
interface Props {
  type: 'dm' | 'player' | 'mechanic' | 'lore';
  title?: string;
}

const { type, title } = Astro.props;

const typeConfig = {
  dm: {
    bgClass: 'bg-red-900/20 border-red-700',
    iconColor: 'text-red-500',
    titleColor: 'text-red-400',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>`,
    defaultTitle: 'Solo per il DM'
  },
  player: {
    bgClass: 'bg-blue-900/20 border-blue-700',
    iconColor: 'text-blue-500',
    titleColor: 'text-blue-400',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
    defaultTitle: 'Info Giocatori'
  },
  mechanic: {
    bgClass: 'bg-emerald-900/20 border-emerald-700',
    iconColor: 'text-emerald-500',
    titleColor: 'text-emerald-400',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>`,
    defaultTitle: 'Regola Meccanica'
  },
  lore: {
    bgClass: 'bg-purple-900/20 border-purple-700',
    iconColor: 'text-purple-500',
    titleColor: 'text-purple-400',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>`,
    defaultTitle: 'Lore'
  }
};

const config = typeConfig[type];
const displayTitle = title || config.defaultTitle;
const dmClass = type === 'dm' ? 'dm-only' : '';
---

<div class={`${config.bgClass} ${dmClass} border-2 rounded-lg p-4 my-4`}>
  <div class="flex items-start space-x-3">
    <svg class={`w-6 h-6 ${config.iconColor} flex-shrink-0 mt-0.5`} fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={config.icon}>
    </svg>
    <div class="flex-1">
      <h4 class={`font-bold ${config.titleColor} mb-2`}>{displayTitle}</h4>
      <div class="text-slate-300 text-sm prose prose-invert max-w-none">
        <slot />
      </div>
    </div>
  </div>
</div>

<style>
  .prose :global(p) {
    margin-bottom: 0.5rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.25rem;
  }

  .prose :global(strong) {
    color: #fbbf24;
    font-weight: 600;
  }

  .prose :global(em) {
    color: #a78bfa;
  }
</style>
