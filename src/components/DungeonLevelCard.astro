---
interface Props {
  levelNumber: number;
  name: string;
  difficulty: number; // 1-5
  rewards: string[];
  dangers: string[];
  theme?: string;
  resetFrequency?: string;
}

const { levelNumber, name, difficulty, rewards, dangers, theme, resetFrequency } = Astro.props;

const difficultyStars = Array(5).fill(0).map((_, i) => i < difficulty);
const difficultyColor = difficulty <= 2 ? 'text-green-500' : difficulty <= 3 ? 'text-yellow-500' : 'text-red-500';
---

<div class="bg-slate-800 border-2 border-slate-700 rounded-lg p-6 hover:border-purple-500 transition-all">
  <div class="flex items-start justify-between mb-4">
    <div>
      <div class="flex items-center gap-3 mb-2">
        <span class="text-3xl font-bold text-purple-400">Lvl {levelNumber}</span>
        <div class="flex items-center gap-1">
          {difficultyStars.map(filled => (
            <svg
              class={`w-4 h-4 ${filled ? difficultyColor : 'text-slate-600'}`}
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
      </div>
      <h3 class="text-xl font-bold text-slate-200 mb-1">{name}</h3>
      {theme && <p class="text-sm text-slate-400 italic">{theme}</p>}
    </div>
    {resetFrequency && (
      <div class="text-right">
        <p class="text-xs text-slate-500 uppercase tracking-wide mb-1">Reset</p>
        <p class="text-sm text-blue-400 font-semibold">{resetFrequency}</p>
      </div>
    )}
  </div>

  <div class="grid md:grid-cols-2 gap-4">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <h4 class="text-sm font-bold text-emerald-400">Ricompense</h4>
      </div>
      <ul class="space-y-1">
        {rewards.map(reward => (
          <li class="text-sm text-slate-300 flex items-start">
            <span class="text-emerald-500 mr-2">"</span>
            <span>{reward}</span>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <div class="flex items-center gap-2 mb-2">
        <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
        <h4 class="text-sm font-bold text-red-400">Pericoli</h4>
      </div>
      <ul class="space-y-1">
        {dangers.map(danger => (
          <li class="text-sm text-slate-300 flex items-start">
            <span class="text-red-500 mr-2">"</span>
            <span>{danger}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>
