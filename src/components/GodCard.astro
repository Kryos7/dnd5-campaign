---
interface Props {
  name: string;
  title: string;
  domain: string[];
  city: string;
  description: string;
  alignment?: string;
}

const { name, title, domain, city, description, alignment = "N/A" } = Astro.props;
---

<div class="bg-gradient-to-br from-slate-800 to-slate-900 border-2 border-yellow-600/50 rounded-lg p-6 hover:border-yellow-500 transition-all hover:shadow-lg hover:shadow-yellow-500/30">
  <div class="flex items-start justify-between mb-4">
    <div class="flex-1">
      <h3 class="text-xl font-bold text-yellow-400 mb-1">{name}</h3>
      <p class="text-sm text-slate-400 italic">{title}</p>
    </div>
    <svg class="w-8 h-8 text-yellow-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
    </svg>
  </div>

  <div class="space-y-3 mb-4">
    <div>
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Domini</p>
      <div class="flex flex-wrap gap-1">
        {domain.map(d => (
          <span class="px-2 py-0.5 bg-purple-900/60 text-purple-200 text-xs rounded border border-purple-700">
            {d}
          </span>
        ))}
      </div>
    </div>

    <div>
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Città</p>
      <span class="px-2 py-0.5 bg-blue-900/60 text-blue-200 text-xs rounded border border-blue-700">
        {city}
      </span>
    </div>

    {alignment !== "N/A" && (
      <div>
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Allineamento</p>
        <span class="text-sm text-slate-300">{alignment}</span>
      </div>
    )}
  </div>

  <p class="text-slate-300 text-sm leading-relaxed">{description}</p>
</div>
