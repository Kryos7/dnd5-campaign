---
interface Props {
  name: string;
  slug: string;
  gods: string[];
  theme: string;
  description: string;
  race: string;
}

const { name, slug, gods, theme, description, race } = Astro.props;
---

<div class="city-card-astro bg-slate-800 border border-slate-700 rounded-lg p-6 hover:border-yellow-500 transition-all hover:shadow-lg hover:shadow-yellow-500/20">
  <div class="flex items-start justify-between mb-4">
    <div>
      <h3 class="text-2xl font-bold text-yellow-500 mb-1">{name}</h3>
      <p class="text-sm text-slate-400">{race}</p>
    </div>
    <div class="flex items-center space-x-1">
      {gods.slice(0, 3).map(() => (
        <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
      ))}
    </div>
  </div>

  <div class="mb-4">
    <p class="text-sm font-semibold text-blue-400 mb-2">Dèi Patroni:</p>
    <div class="flex flex-wrap gap-2">
      {gods.map(god => (
        <span class="px-2 py-1 bg-blue-900/50 text-blue-300 text-xs rounded-full border border-blue-700">
          {god}
        </span>
      ))}
    </div>
  </div>

  <div class="mb-4">
    <p class="text-sm font-semibold text-purple-400 mb-1">Tema:</p>
    <p class="text-purple-300 text-sm">{theme}</p>
  </div>

  <p class="text-slate-300 text-sm mb-4 line-clamp-3">{description}</p>

  <a
    href={`/citta/${slug}`}
    class="text-white inline-flex items-center px-4 py-2 bg-yellow-600 hover:bg-yellow-500 text-slate-900 font-semibold rounded-lg transition-colors no-underline"
  >
    Esplora
    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
  </a>
</div>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
