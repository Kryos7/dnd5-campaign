---
import MainLayout from '../../layouts/MainLayout.astro';
import InfoBox from '../../components/InfoBox.astro';
---

<MainLayout title="Quick Reference">
  <h1 class="mb-8">Tabelle di Riferimento Rapido</h1>

  <div class="mb-8">
    <p class="text-lg text-slate-300 mb-4">
      Questa sezione conterrà tabelle riassuntive per consultazione rapida durante le sessioni di gioco.
    </p>
  </div>

  <InfoBox type="mechanic" title="Work in Progress">
    <p>Tabelle di riferimento, glossario e note per il DM saranno aggiunte presto!</p>
  </InfoBox>

  <div class="mt-8 text-center">
    <a href="/" class="text-blue-400 hover:text-blue-300">Torna alla Home</a>
  </div>
</MainLayout>
