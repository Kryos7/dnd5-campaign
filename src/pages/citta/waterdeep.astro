---
import MainLayout from '../../layouts/MainLayout.astro';
import InfoBox from '../../components/InfoBox.astro';
import GodCard from '../../components/GodCard.astro';
import fs from 'fs';
import path from 'path';

const cittaPath = path.join(process.cwd(), 'public', 'data', 'citta.json');
const deiPath = path.join(process.cwd(), 'public', 'data', 'dei.json');

const cittaData = JSON.parse(fs.readFileSync(cittaPath, 'utf-8'));
const deiData = JSON.parse(fs.readFileSync(deiPath, 'utf-8'));

const city = cittaData.find((c: any) => c.slug === 'waterdeep');
const cityGods = deiData.filter((d: any) => city.gods.includes(d.name));
---

<MainLayout title={city.name}>
  <!-- Breadcrumbs -->
  <nav class="mb-6 text-sm text-slate-400">
    <a href="/" class="hover:text-yellow-400">Home</a>
    <span class="mx-2">/</span>
    <a href="/citta/overview" class="hover:text-yellow-400">Città</a>
    <span class="mx-2">/</span>
    <span class="text-slate-300">{city.name}</span>
  </nav>

  <!-- Hero Header -->
  <div class="bg-gradient-to-br from-blue-900 via-slate-800 to-blue-900 border-2 border-blue-600 rounded-lg p-8 mb-8">
    <div class="flex items-start justify-between mb-4">
      <div>
        <h1 class="text-5xl mb-2 text-yellow-400">{city.name}</h1>
        <p class="text-2xl text-blue-300 italic">La Città degli Splendori</p>
        <p class="text-lg text-slate-400 mt-2">{city.race}</p>
      </div>
      <div class="text-right">
        <div class="text-sm text-slate-400 mb-1">Tema</div>
        <div class="text-xl font-bold text-purple-400">{city.theme}</div>
        <div class="text-sm text-slate-400 mt-3">Popolazione</div>
        <div class="text-lg text-emerald-400">{city.population}</div>
      </div>
    </div>
    <div class="bg-slate-900/50 rounded-lg p-4 mt-4">
      <p class="text-slate-200 leading-relaxed whitespace-pre-line">{city.fullDescription}</p>
    </div>
  </div>

  <!-- Quick Stats -->
  <section class="mb-8">
    <div class="grid md:grid-cols-3 gap-4">
      <div class="bg-slate-800 border border-slate-700 rounded-lg p-4">
        <div class="text-sm text-slate-400 mb-1">Governo</div>
        <div class="text-lg text-yellow-400">{city.government}</div>
      </div>
      <div class="bg-slate-800 border border-slate-700 rounded-lg p-4">
        <div class="text-sm text-slate-400 mb-1">Economia</div>
        <div class="text-lg text-emerald-400">{city.economy.status}</div>
        <div class="text-sm text-slate-500">Inflazione: {city.economy.inflation}</div>
      </div>
      <div class="bg-slate-800 border border-slate-700 rounded-lg p-4">
        <div class="text-sm text-slate-400 mb-1">Barriera Divina</div>
        <div class="text-lg text-red-400">{city.divineBarrier.active ? 'ATTIVA' : 'Inattiva'}</div>
        <div class="text-sm text-slate-500">Nessuno può entrare/uscire</div>
      </div>
    </div>
  </section>

  <!-- Cultura e Atmosfera -->
  <section class="mb-8">
    <h2 class="text-3xl font-bold mb-4 text-blue-400">Cultura e Atmosfera</h2>
    <div class="bg-slate-800 border border-slate-700 rounded-lg p-6">
      <p class="text-slate-300 leading-relaxed">{city.culture}</p>
    </div>
  </section>

  <!-- Dèi Patroni - Triade Divina -->
  <section class="mb-8">
    <h2 class="text-3xl font-bold mb-4 text-yellow-400">La Triade Divina</h2>
    <div class="bg-gradient-to-r from-red-900/20 via-yellow-900/20 to-blue-900/20 border-2 border-yellow-600 rounded-lg p-6 mb-6">
      <p class="text-slate-200 text-center text-lg">
        <span class="text-red-400 font-bold">Tempus</span> • <span class="text-yellow-400 font-bold">Tymora</span> • <span class="text-blue-400 font-bold">Mystra</span>
      </p>
      <p class="text-slate-400 text-center mt-2">Strategia, Fortuna e Conoscenza in perfetto equilibrio</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {cityGods.map((god: any) => (
        <GodCard
          name={god.name}
          title={god.title}
          domain={god.domain}
          city={god.city}
          description={god.description}
          alignment={god.alignment}
        />
      ))}
    </div>
  </section>

  <!-- Luoghi Chiave Dettagliati -->
  <section class="mb-8">
    <h2 class="text-3xl font-bold mb-4 text-purple-400">Luoghi Chiave</h2>
    <div class="space-y-4">
      {city.keyLocations.map((location: any) => (
        <div class="bg-slate-800 border-2 border-slate-700 rounded-lg p-6 hover:border-purple-500 transition-colors">
          <div class="flex items-start justify-between mb-3">
            <h3 class="text-xl font-bold text-purple-300">{location.name}</h3>
            <div class="flex items-center gap-2">
              {location.type === 'dungeon-entrance' && (
                <span class="bg-red-900/50 text-red-300 px-3 py-1 rounded-full text-xs border border-red-700">
                  INGRESSO DUNGEON
                </span>
              )}
              {location.type === 'temple' && (
                <span class="bg-yellow-900/50 text-yellow-300 px-3 py-1 rounded-full text-xs border border-yellow-700">
                  TEMPIO
                </span>
              )}
              {location.type === 'arena' && (
                <span class="bg-blue-900/50 text-blue-300 px-3 py-1 rounded-full text-xs border border-blue-700">
                  ARENA
                </span>
              )}
              <span class="text-sm text-slate-500">{location.district}</span>
            </div>
          </div>
          <p class="text-slate-300 leading-relaxed">{location.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- I Ward (Quartieri) -->
  <section class="mb-8">
    <h2 class="text-3xl font-bold mb-4 text-emerald-400">I Sette Ward (Quartieri)</h2>
    <div class="grid md:grid-cols-2 gap-4">
      {city.wards.map((ward: any) => (
        <div class="bg-slate-800 border border-slate-700 rounded-lg p-4 hover:border-emerald-500 transition-colors">
          <div class="flex items-start">
            <svg class="w-6 h-6 text-emerald-500 mr-3 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            <div>
              <h3 class="text-lg font-bold text-emerald-300 mb-1">{ward.name}</h3>
              <p class="text-slate-400 text-sm">{ward.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Sistema Unico -->
  <section class="mb-8">
    <h2 class="text-3xl font-bold mb-4 text-yellow-400">Sistema Unico di Waterdeep</h2>
    <InfoBox type="mechanic" title={city.uniqueSystem.name}>
      <p>{city.uniqueSystem.description}</p>
      <div class="mt-4 flex gap-4 justify-center">
        <div class="text-center">
          <div class="text-red-400 text-2xl font-bold">Tempus</div>
          <div class="text-sm text-slate-400">Strategia e Onore</div>
        </div>
        <div class="text-center">
          <div class="text-yellow-400 text-2xl font-bold">Tymora</div>
          <div class="text-sm text-slate-400">Rischio e Fortuna</div>
        </div>
        <div class="text-center">
          <div class="text-blue-400 text-2xl font-bold">Mystra</div>
          <div class="text-sm text-slate-400">Conoscenza e Magia</div>
        </div>
      </div>
    </InfoBox>
  </section>

  <!-- Economia del Gioco Divino -->
  <section class="mb-8">
    <h2 class="text-3xl font-bold mb-4 text-emerald-400">Economia Durante il Gioco</h2>
    <div class="grid md:grid-cols-2 gap-6">
      <div class="bg-slate-800 border border-slate-700 rounded-lg p-6">
        <h3 class="text-xl font-bold text-emerald-300 mb-3">Nuovi Servizi</h3>
        <ul class="space-y-2">
          {city.economy.newServices.map((service: string) => (
            <li class="text-slate-300 flex items-start">
              <svg class="w-5 h-5 text-emerald-500 mr-2 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              {service}
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-slate-800 border border-slate-700 rounded-lg p-6">
        <h3 class="text-xl font-bold text-blue-300 mb-3">Divisioni Sociali</h3>
        <div class="space-y-3">
          <div>
            <div class="flex justify-between mb-1">
              <span class="text-emerald-400">Pro-Gioco</span>
              <span class="text-slate-400 text-sm">{city.socialDivisions.proGame}</span>
            </div>
            <div class="w-full bg-slate-700 rounded-full h-2">
              <div class="bg-emerald-500 h-2 rounded-full" style="width: 80%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between mb-1">
              <span class="text-yellow-400">Neutrali</span>
              <span class="text-slate-400 text-sm">{city.socialDivisions.neutral}</span>
            </div>
            <div class="w-full bg-slate-700 rounded-full h-2">
              <div class="bg-yellow-500 h-2 rounded-full" style="width: 15%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between mb-1">
              <span class="text-red-400">Contro-Gioco</span>
              <span class="text-slate-400 text-sm">{city.socialDivisions.againstGame}</span>
            </div>
            <div class="w-full bg-slate-700 rounded-full h-2">
              <div class="bg-red-500 h-2 rounded-full" style="width: 5%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Barriera Divina -->
  <section class="mb-8">
    <h2 class="text-3xl font-bold mb-4 text-red-400">Barriera Divina</h2>
    <InfoBox type="dm" title="Sigillo degli Dèi">
      <p class="text-slate-300">{city.divineBarrier.description}</p>
      <div class="mt-4 bg-red-900/20 border border-red-800 rounded-lg p-4">
        <p class="text-red-300 text-sm">
          <strong>Nota DM:</strong> La barriera è stata creata dall'entità primordiale per impedire agli dèi di fuggire, non per proteggere la città. Mystra lo sospetta.
        </p>
      </div>
    </InfoBox>
  </section>

  <!-- Dungeon Theme -->
  <section class="mb-8">
    <h2 class="text-3xl font-bold mb-4 text-red-400">Tema del Dungeon</h2>
    <div class="bg-gradient-to-r from-red-900/20 to-purple-900/20 border-2 border-red-700 rounded-lg p-6">
      <p class="text-slate-300 text-lg leading-relaxed">{city.dungeonTheme}</p>
      <div class="mt-4 text-center">
        <a href="/dungeon/overview" class="inline-flex items-center gap-2 bg-red-900/50 hover:bg-red-800/50 text-red-300 px-6 py-3 rounded-lg border border-red-700 transition-colors no-underline">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
          </svg>
          Esplora il Dungeon di Waterdeep
        </a>
      </div>
    </div>
  </section>

  <!-- Navigation -->
  <div class="flex justify-between mt-12 pt-6 border-t border-slate-700">
    <a href="/citta/overview" class="inline-flex items-center text-blue-400 hover:text-blue-300 no-underline">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Torna a Tutte le Città
    </a>
    <a href="/citta/mithral-hall" class="inline-flex items-center text-blue-400 hover:text-blue-300 no-underline">
      Prossima: Mithral Hall
      <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</MainLayout>
