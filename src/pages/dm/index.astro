---
import DMAuthGuard from '../../components/dm/DMAuthGuard';
import '../../styles/global.css';

const dmSections = [
  {
    title: 'Ecosistema 1 - Fondamenta Familiari',
    description: 'Guida completa per i livelli 1-3, inclusi stanze dettagliate, boss Grolnek e missioni divine',
    href: '/dm/ecosistema-1',
    icon: '🗺️',
    color: 'red',
    status: 'Disponibile'
  },
  {
    title: 'Ecosistema 2',
    description: 'Prossimo ecosistema in arrivo',
    href: '#',
    icon: '🏔️',
    color: 'gray',
    status: 'In Preparazione'
  },
  {
    title: 'PNG e Fazioni',
    description: 'Database di PNG, gilde e relazioni tra fazioni',
    href: '#',
    icon: '👥',
    color: 'gray',
    status: 'In Preparazione'
  },
  {
    title: 'Tracking Favore Divino',
    description: 'Sistema per tracciare il favore divino del party',
    href: '#',
    icon: '✨',
    color: 'gray',
    status: 'In Preparazione'
  }
];
---

<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard DM | D&D Campaign</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-slate-900 text-slate-100">
  <DMAuthGuard client:only="react">
    <div class="min-h-screen">
      <!-- Header -->
    <header class="bg-gradient-to-r from-red-950 via-purple-950 to-red-950 border-b-4 border-red-700 py-8 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h1 class="text-4xl font-bold text-red-400 flex items-center gap-3 mb-2">
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              Dashboard Dungeon Master
            </h1>
            <p class="text-xl text-red-300">È Sbagliato Cercare Gloria in un Dungeon Divino?</p>
          </div>
          <a href="/" class="px-6 py-3 bg-slate-800 hover:bg-slate-700 rounded-lg text-white font-semibold transition-colors flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Torna alla Wiki
          </a>
        </div>

        <div class="bg-red-900/30 border border-red-700 rounded-lg p-4">
          <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-yellow-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <div>
              <h3 class="font-bold text-red-400 mb-1">⚠️ ATTENZIONE - Contenuto Riservato</h3>
              <p class="text-sm text-slate-300">
                Questa sezione contiene informazioni sensibili sulla campagna, inclusi segreti di trama, statistiche dei boss,
                e dettagli che potrebbero rovinare l'esperienza dei giocatori. Non condividere questi contenuti con il party!
              </p>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-6 py-12">
      <!-- Quick Stats -->
      <div class="grid md:grid-cols-4 gap-6 mb-12">
        <div class="bg-gradient-to-br from-blue-900/30 to-blue-800/20 border-2 border-blue-700 rounded-lg p-6">
          <div class="text-sm text-blue-400 mb-1">Party Livello Attuale</div>
          <div class="text-4xl font-bold text-blue-300">3</div>
        </div>
        <div class="bg-gradient-to-br from-purple-900/30 to-purple-800/20 border-2 border-purple-700 rounded-lg p-6">
          <div class="text-sm text-purple-400 mb-1">Ecosistemi Disponibili</div>
          <div class="text-4xl font-bold text-purple-300">1</div>
        </div>
        <div class="bg-gradient-to-br from-yellow-900/30 to-yellow-800/20 border-2 border-yellow-700 rounded-lg p-6">
          <div class="text-sm text-yellow-400 mb-1">Favore Divino Totale</div>
          <div class="text-4xl font-bold text-yellow-300">500+</div>
        </div>
        <div class="bg-gradient-to-br from-green-900/30 to-green-800/20 border-2 border-green-700 rounded-lg p-6">
          <div class="text-sm text-green-400 mb-1">Sessioni Pianificate</div>
          <div class="text-4xl font-bold text-green-300">6-8</div>
        </div>
      </div>

      <!-- Sections Grid -->
      <div>
        <h2 class="text-3xl font-bold text-yellow-400 mb-6">📚 Sezioni Disponibili</h2>
        <div class="grid md:grid-cols-2 gap-6">
          {dmSections.map((section) => (
            <a
              href={section.href}
              class={`block bg-slate-800 border-2 rounded-lg p-6 transition-all hover:shadow-lg group ${
                section.status === 'Disponibile'
                  ? `border-${section.color}-700 hover:border-${section.color}-500 hover:shadow-${section.color}-500/20`
                  : 'border-slate-700 hover:border-slate-600 opacity-60 cursor-not-allowed'
              }`}
              aria-disabled={section.status !== 'Disponibile'}
            >
              <div class="flex items-start justify-between mb-4">
                <div class="flex items-center gap-3">
                  <span class="text-4xl">{section.icon}</span>
                  <div>
                    <h3 class={`text-xl font-bold ${
                      section.status === 'Disponibile' ? `text-${section.color}-400 group-hover:text-${section.color}-300` : 'text-slate-400'
                    }`}>
                      {section.title}
                    </h3>
                    <span class={`inline-block px-2 py-1 rounded text-xs font-semibold mt-1 ${
                      section.status === 'Disponibile'
                        ? 'bg-green-900/50 text-green-400 border border-green-700'
                        : 'bg-slate-700 text-slate-400 border border-slate-600'
                    }`}>
                      {section.status}
                    </span>
                  </div>
                </div>
                {section.status === 'Disponibile' && (
                  <svg class="w-6 h-6 text-red-400 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                  </svg>
                )}
              </div>
              <p class="text-slate-400 text-sm">{section.description}</p>
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Access Tools -->
      <div class="mt-12">
        <h2 class="text-3xl font-bold text-yellow-400 mb-6">🛠️ Strumenti Rapidi</h2>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-slate-800 border border-slate-700 rounded-lg p-6">
            <h3 class="text-lg font-bold text-blue-400 mb-3 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
              </svg>
              Documenti Originali
            </h3>
            <ul class="space-y-2 text-sm text-slate-400">
              <li>• ECOSISTEMA_1_DETTAGLIATO.md</li>
              <li>• Mappe e layout dungeon</li>
              <li>• Note di sessione</li>
            </ul>
          </div>

          <div class="bg-slate-800 border border-slate-700 rounded-lg p-6">
            <h3 class="text-lg font-bold text-purple-400 mb-3 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
              </svg>
              Checklist Pre-Sessione
            </h3>
            <ul class="space-y-2 text-sm text-slate-400">
              <li>☐ Mappe stampate</li>
              <li>☐ Schede mostri pronte</li>
              <li>☐ Tracking Favore aggiornato</li>
              <li>☐ Musica ambientale</li>
            </ul>
          </div>

          <div class="bg-slate-800 border border-slate-700 rounded-lg p-6">
            <h3 class="text-lg font-bold text-green-400 mb-3 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Tips DM
            </h3>
            <ul class="space-y-2 text-sm text-slate-400">
              <li>• Descrivi vivacemente l'atmosfera</li>
              <li>• Comunica guadagni Favore in tempo reale</li>
              <li>• Adatta difficoltà al party</li>
            </ul>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="bg-slate-950 border-t border-red-900 py-6 mt-12">
      <div class="max-w-7xl mx-auto px-6 text-center">
        <p class="text-slate-400 text-sm">
          🎲 Buona fortuna, Dungeon Master! Che Tempus, Tymora e Mystra ti guidino!
        </p>
        <p class="text-slate-500 text-xs mt-2">
          Dashboard creata per la campagna "È Sbagliato Cercare Gloria in un Dungeon Divino?"
        </p>
      </div>
    </footer>
    </div>
  </DMAuthGuard>
</body>
</html>
