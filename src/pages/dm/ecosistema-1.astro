---
import DMAuthGuard from '../../components/dm/DMAuthGuard';
import EcosistemaView from '../../components/dm/EcosistemaView';
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ecosistema 1 - Sezione DM | D&D Campaign</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-slate-900 text-slate-100">
  <DMAuthGuard client:only="react">
    <div class="min-h-screen">
      <!-- Header DM -->
      <header class="bg-red-950 border-b-4 border-red-700 py-4 px-6 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
          <div class="flex items-center gap-4">
            <a href="/" class="text-slate-300 hover:text-white transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
              </svg>
            </a>
            <div>
              <h1 class="text-2xl font-bold text-red-400 flex items-center gap-2">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
                Sezione DM
              </h1>
              <p class="text-sm text-red-300">Contenuto riservato al Dungeon Master</p>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <a href="/dm" class="px-4 py-2 bg-red-700 hover:bg-red-600 rounded text-white font-semibold transition-colors">
              Dashboard DM
            </a>
          </div>
        </div>
      </header>

      <!-- Main Content -->
      <main class="py-8">
        <EcosistemaView client:only="react" />
      </main>

      <!-- Footer -->
      <footer class="bg-slate-950 border-t border-red-900 py-6 mt-12">
        <div class="max-w-7xl mx-auto px-6 text-center">
          <p class="text-slate-400 text-sm">
            ⚠️ Questa è una sezione riservata al DM. Non condividere con i giocatori!
          </p>
          <p class="text-slate-500 text-xs mt-2">
            Documento: ECOSISTEMA_1_DETTAGLIATO.md | Versione 1.0 Operativa
          </p>
        </div>
      </footer>
    </div>
  </DMAuthGuard>
</body>
</html>
