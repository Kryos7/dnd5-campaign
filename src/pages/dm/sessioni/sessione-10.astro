              <th class="text-left pb-2 pl-4">Nota</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-800/60 text-gray-300">
            <tr>
              <td class="py-2 pr-4 font-bold text-orange-200">Rooks Fenmarsh</td>
              <td class="py-2 px-4 text-gray-400">Squadra B / Monete Fortunate (defezione dai Guardiani)</td>
              <td class="py-2 px-4 text-gray-400">Ladro — leader/scout</td>
              <td class="py-2 pl-4 text-gray-500 text-xs">Il recruiter di Thalio. Finalmente titolare.</td>
            </tr>
            <tr>
              <td class="py-2 pr-4 font-bold text-orange-200">Mira Swiftfoot</td>
              <td class="py-2 px-4 text-gray-400">Defezione dallo Scudo Radiante</td>
              <td class="py-2 px-4 text-gray-400">Ladra (Arcane Trickster) — utility</td>
