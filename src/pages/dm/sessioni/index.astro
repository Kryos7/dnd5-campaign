---
import MainLayout from "../../../layouts/MainLayout.astro";

const sessioni = [
  {
    numero: 0,
    titolo: "La Discesa degli Dèi",
    slug: "sessione-0",
    data: "10/01/2026",
    tipo: "Introduzione/Setup",
    status: "Pianificata",
    durata: "3-4 ore",
    descrizione: "Introduzione all'ambientazione, spiegazione del Gioco Divino, presentazione dei personaggi, descrizione delle Prove Divine per ogni città."
  },
  {
    numero: 1,
    titolo: "L'ingresso nell'Arco Divino",
    slug: "sessione-1",
    data: "24/01/2026",
    tipo: "Prima Esplorazione",
    status: "Completata",
    durata: "3-4 ore",
    descrizione: "Attraversamento dell'Arco Divino, comparsa del Marchio Divino, primo ingresso nelle Fogne Superiori dell'Ecosistema 1."
  },
  {
    numero: 2,
    titolo: "Esplorazione delle Fogne",
    slug: "sessione-2",
    data: "21/02/2026",
    tipo: "Esplorazione e Dungeoncrawl",
    status: "Completata",
    durata: "4-5 ore",
    descrizione: "Completamento quasi totale del Piano 1. Forziere sommerso, Camera delle Quattro Leve, ratti giganti e Fungo Violaceo Mutato. Due Tomi di Mystra recuperati. Magia selvaggia di Riven evoca 5 Flumph."
  },
  {
    numero: 3,
    titolo: "Il Confine tra i Piani",
    slug: "sessione-3",
    data: "TBD",
    tipo: "Transizione e Scelta",
    status: "Completata",
    durata: "4-5 ore",
    descrizione: "Completamento del Piano 1, prima discesa al Pianerottolo, incontro con Vex. Acquisti all'Emporio. Decisione di scendere al Piano 2."
  },
  {
    numero: 8,
    titolo: "Il Secondo Pianerottolo",
    slug: "sessione-8",
    data: "TBD",
    tipo: "Transizione e Scelta",
    status: "In Preparazione",
    durata: "4-5 ore",
    descrizione: "Dopo la sconfitta della Matriarca, i Guardiani emergono al secondo Pianerottolo. Vex, lo stato delle gilde, la cicatrice di Riven, i Nodi della Trama, la scelta tra tornare in città o scendere da Kethrar."
  }
];
---

<MainLayout title="Sessioni - DM Area" description="Registro delle sessioni di gioco">
  <div class="max-w-[1440px] mx-auto">
    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-4">📖 Registro Sessioni</h1>
      <p class="text-lg text-gray-300">
        Tutte le sessioni di gioco della campagna "È Sbagliato Cercare Gloria in un Dungeon Divino?"
      </p>
    </div>

    <!-- Statistiche Generali -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <div class="bg-gray-800/50 border border-gray-700 rounded-lg p-6">
        <div class="text-3xl font-bold text-blue-400 mb-2">{sessioni.length}</div>
        <div class="text-gray-400">Sessioni Totali</div>
      </div>
      <div class="bg-gray-800/50 border border-gray-700 rounded-lg p-6">
        <div class="text-3xl font-bold text-green-400 mb-2">
          {sessioni.filter(s => s.status === "Completata").length}
        </div>
        <div class="text-gray-400">Completate</div>
      </div>
      <div class="bg-gray-800/50 border border-gray-700 rounded-lg p-6">
        <div class="text-3xl font-bold text-yellow-400 mb-2">
          {sessioni.filter(s => s.status === "Pianificata").length}
        </div>
        <div class="text-gray-400">Pianificate</div>
      </div>
    </div>

    <!-- Lista Sessioni -->
    <div class="space-y-4">
      {sessioni.map((sessione) => (
        <a
          href={`/dm/sessioni/${sessione.slug}`}
          class="block bg-gray-800/30 hover:bg-gray-800/50 border border-gray-700 rounded-lg p-6 transition-all hover:scale-[1.02]"
        >
          <div class="flex items-start justify-between mb-4">
            <div class="flex items-center gap-4">
              <div class="text-5xl font-bold text-gray-600">
                {String(sessione.numero).padStart(2, '0')}
              </div>
              <div>
                <h2 class="text-2xl font-bold mb-1">{sessione.titolo}</h2>
                <div class="flex gap-3 text-sm text-gray-400">
                  <span class="flex items-center gap-1">
                    <span>📅</span> {sessione.data}
                  </span>
                  <span class="flex items-center gap-1">
                    <span>⏱️</span> {sessione.durata}
                  </span>
                  <span class="flex items-center gap-1">
                    <span>🎭</span> {sessione.tipo}
                  </span>
                </div>
              </div>
            </div>
            <div>
              {sessione.status === "Completata" && (
                <span class="inline-block px-3 py-1 bg-green-500/20 text-green-400 rounded-full text-sm">
                  ✓ Completata
                </span>
              )}
              {sessione.status === "Pianificata" && (
                <span class="inline-block px-3 py-1 bg-yellow-500/20 text-yellow-400 rounded-full text-sm">
                  📋 Pianificata
                </span>
              )}
              {sessione.status === "In Corso" && (
                <span class="inline-block px-3 py-1 bg-blue-500/20 text-blue-400 rounded-full text-sm">
                  ▶️ In Corso
                </span>
              )}
            </div>
          </div>

          <p class="text-gray-300 leading-relaxed">
            {sessione.descrizione}
          </p>
        </a>
      ))}
    </div>
  </div>
</MainLayout>
