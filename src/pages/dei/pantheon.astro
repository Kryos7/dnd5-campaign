---
import MainLayout from '../../layouts/MainLayout.astro';
import GodCard from '../../components/GodCard.astro';
import fs from 'fs';
import path from 'path';

const deiPath = path.join(process.cwd(), 'public', 'data', 'dei.json');
const deiData = JSON.parse(fs.readFileSync(deiPath, 'utf-8'));

const cities = ['Waterdeep', 'Mithral Hall', 'Menzoberranzan', 'Myth Drannor', "Baldur's Gate", 'Candlekeep', 'Luskan'];
const godsByCity = cities.map(city => ({
  city,
  gods: deiData.filter((god: any) => god.city === city)
}));
---

<MainLayout title="Il Pantheon Divino">
  <!-- Breadcrumbs -->
  <nav class="mb-6 text-sm text-slate-400">
    <a href="/" class="hover:text-yellow-400">Home</a>
    <span class="mx-2">/</span>
    <a href="/dei/pantheon" class="hover:text-yellow-400">Dèi</a>
    <span class="mx-2">/</span>
    <span class="text-slate-300">Pantheon</span>
  </nav>

  <!-- Hero Section -->
  <div class="text-center mb-12">
    <div class="inline-block mb-4">
      <svg class="w-20 h-20 text-yellow-500 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
      </svg>
    </div>
    <h1 class="mb-4">Il Pantheon Divino</h1>
    <p class="text-xl text-slate-400 max-w-3xl mx-auto">
      I 21 dèi che sono scesi sul Piano Materiale per orchestrare il Gioco Divino. Ognuno porta i propri obiettivi,
      le proprie aspettative, e le proprie ricompense.
    </p>
  </div>

  <!-- Introduzione -->
  <div class="bg-gradient-to-r from-purple-900/20 to-blue-900/20 border-2 border-purple-700/50 rounded-lg p-8 mb-12">
    <h2 class="text-2xl font-bold text-purple-400 mb-4">Perché Questi Dèi?</h2>
    <p class="text-slate-300 leading-relaxed mb-4">
      Non tutti gli dèi di Faerun hanno scelto di partecipare al Gioco Divino. Solo 21 divinità - tre per ogni città -
      hanno deciso di scendere fisicamente sul Piano Materiale. La loro scelta non è casuale: ognuno rappresenta un
      aspetto specifico del carattere e della cultura della propria città.
    </p>
    <p class="text-slate-300 leading-relaxed">
      Alcuni dèi sono alleati naturali, altri nemici giurati. Le loro relazioni aggiungono un livello di complessità
      al Gioco: ottenere favore da un dio potrebbe significare perdere quello di un altro.
    </p>
  </div>

  <!-- Dèi per Città -->
  {godsByCity.map(({ city, gods }) => (
    <section class="mb-16">
      <div class="flex items-center mb-6">
        <h2 class="text-4xl font-bold text-yellow-400">{city}</h2>
        <div class="ml-4 flex-1 h-px bg-gradient-to-r from-yellow-600 to-transparent"></div>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {gods.map((god: any) => (
          <div>
            <GodCard
              name={god.name}
              title={god.title}
              domain={god.domain}
              city={god.city}
              description={god.description}
              alignment={god.alignment}
            />

            <!-- Dettagli Aggiuntivi -->
            <div class="mt-4 space-y-3">
              <details class="bg-slate-800 border border-slate-700 rounded-lg p-4 hover:border-emerald-600 transition-colors">
                <summary class="cursor-pointer font-bold text-emerald-400 flex items-center">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  Benedizioni e Ricompense
                </summary>
                <p class="mt-3 text-sm text-slate-300 dm-only">{god.blessings}</p>
              </details>

              <details class="bg-slate-800 border border-slate-700 rounded-lg p-4 hover:border-blue-600 transition-colors">
                <summary class="cursor-pointer font-bold text-blue-400 flex items-center">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  Cosa Si Aspetta
                </summary>
                <p class="mt-3 text-sm text-slate-300">{god.expectations}</p>
              </details>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <!-- Relazioni tra Dèi -->
  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-6 text-purple-400">Alleanze e Rivalità</h2>
    <div class="bg-slate-800 border border-slate-700 rounded-lg p-6">
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <h3 class="text-xl font-bold text-emerald-400 mb-3 flex items-center">
            <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
            Alleanze Naturali
          </h3>
          <ul class="space-y-2 text-slate-300 text-sm">
            <li><strong class="text-yellow-400">Tyr + Moradin</strong> - Legge e ordine</li>
            <li><strong class="text-yellow-400">Mystra + Corellon</strong> - Magia e arte</li>
            <li><strong class="text-yellow-400">Waukeen + Gond</strong> - Commercio e innovazione</li>
            <li><strong class="text-yellow-400">Sehanine + Hanali</strong> - Bellezza e mistero</li>
            <li><strong class="text-yellow-400">Oghma + Savras</strong> - Conoscenza e verità</li>
            <li><strong class="text-yellow-400">Mystra + Oghma</strong> - Magia e sapere</li>
          </ul>
        </div>

        <div>
          <h3 class="text-xl font-bold text-red-400 mb-3 flex items-center">
            <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            Rivalità Intense
          </h3>
          <ul class="space-y-2 text-slate-300 text-sm">
            <li><strong class="text-red-400">Tyr + Lolth</strong> - Ordine vs Caos</li>
            <li><strong class="text-red-400">Corellon + Lolth</strong> - Antica nemesi elfica</li>
            <li><strong class="text-red-400">Moradin + Kiaransalee</strong> - Creazione vs Non-morte</li>
            <li><strong class="text-red-400">Tymora + Beshaba</strong> - Fortuna vs Sfortuna</li>
            <li><strong class="text-red-400">Tyr + Mask</strong> - Legge vs Furto</li>
            <li><strong class="text-red-400">Oghma + Vecna</strong> - Verità condivisa vs Segreti custoditi</li>
            <li><strong class="text-red-400">Tyr + Talos</strong> - Ordine vs Anarchia</li>
            <li><strong class="text-red-400">Waterdeep + Luskan</strong> - Rivalità storica tra città</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Come Ottenere Favore -->
  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-6 text-yellow-400">Come Ottenere Favore Divino</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-emerald-900/20 border-2 border-emerald-700 rounded-lg p-6">
        <svg class="w-12 h-12 text-emerald-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <h3 class="text-xl font-bold text-emerald-400 mb-3">Completare Livelli</h3>
        <p class="text-sm text-slate-300">
          Ogni livello del dungeon completato fornisce Favore automatico a tutti i dèi patroni della tua città.
        </p>
      </div>

      <div class="bg-blue-900/20 border-2 border-blue-700 rounded-lg p-6">
        <svg class="w-12 h-12 text-blue-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
        <h3 class="text-xl font-bold text-blue-400 mb-3">Missioni Divine</h3>
        <p class="text-sm text-slate-300">
          Gli dèi occasionalmente offrono missioni specifiche. Completarle fornisce Favore extra con quel dio.
        </p>
      </div>

      <div class="bg-purple-900/20 border-2 border-purple-700 rounded-lg p-6">
        <svg class="w-12 h-12 text-purple-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11"/>
        </svg>
        <h3 class="text-xl font-bold text-purple-400 mb-3">Agire Secondo Principi</h3>
        <p class="text-sm text-slate-300">
          Ogni dio premia azioni allineate ai propri valori. Tyr premia la giustizia, Lolth il tradimento, etc.
        </p>
      </div>
    </div>
  </section>

  <!-- Navigation -->
  <div class="flex justify-center mt-12 pt-6 border-t border-slate-700">
    <a href="/" class="inline-flex items-center text-blue-400 hover:text-blue-300 no-underline">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Torna alla Home
    </a>
  </div>
</MainLayout>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }

  details[open] summary svg {
    transform: rotate(90deg);
    transition: transform 0.2s;
  }
</style>
