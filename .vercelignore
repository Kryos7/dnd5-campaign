# Vercel Ignore File
# Files and directories that Vercel should ignore during deployment

# Build outputs (these are generated by Vercel during build)
dist/
.vercel/

# Development files
.env
.env.local
.env.development

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Documentation and notes (optional)
# docs/
# notes/
